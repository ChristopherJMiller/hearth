# dev/services.env — canonical dev service URLs (single source of truth)
#
# Sourced by `just dev`, `just dev-full`, `just dev-watch`, `just worker`.
# These values get baked into per-user home-manager closures by the build
# worker (see crates/hearth-api/src/build/user_env.rs:fleet_config_from_env),
# so they MUST be reachable **from inside the fleet VM** — not the host.
#
# `*.hearth.local` hosts resolve to:
#   - host: 127.0.0.1 (after `just host-aliases`, optional for host testing)
#   - VM:   10.0.2.2  (QEMU host gateway, baked into the VM's /etc/hosts
#                      via `networking.hosts` in dev/fleet-vm.nix)
#
# `dev/fleet-vm.nix` carries an analogous block of URLs for the **system**
# closure (kanidm provider URL, system Firefox bookmarks, etc.). If you
# change a hostname or port here, mirror it there too — there is no
# automatic sync (yet).
#
# Ports here point directly at the service's host-published port. Caddy
# proxies the same services on 80/443 under the same hostnames; pick
# whichever fits the consumer.

# Hearth API — agent ↔ control plane, OIDC redirect, env-closure lookups.
export HEARTH_SERVER_URL=http://api.hearth.local:3000

# Matrix / chat. The Matrix client in the closure dials this.
export HEARTH_CHAT_URL=http://chat.hearth.local:8088
export HEARTH_MATRIX_SERVER_NAME=hearth.local

# Nextcloud — desktop sync client config + Thunderbird + LibreOffice.
export HEARTH_CLOUD_URL=http://cloud.hearth.local:8089

# Kanidm — OIDC issuer; agent and PAM are configured separately via
# system module, but home-modules/firefox.nix uses this for bookmarks.
export HEARTH_IDENTITY_URL=https://kanidm.hearth.local:8443

# Mail (Stalwart). Empty until the dev Stalwart instance is wired up; the
# closure modules treat missing values as "feature disabled".
export HEARTH_MAIL_IMAP_HOST=mail.hearth.local
export HEARTH_MAIL_SMTP_HOST=mail.hearth.local
export HEARTH_MAIL_DOMAIN=hearth.local
