# Rust
target/

# Node
node_modules/

# Nix
result
result-*

# SQLx offline metadata (checked in for CI, but regenerated locally)
# .sqlx/

# Environment
.env
.env.local
.direnv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Dev artifacts (VM disks, ephemeral state)
dev/*.qcow2
dev/*.img
dev/vms/
dev/fleet-vm-logs/
dev/kanidm/.env
# Only ignore the private key — the cert is public and needed by the enrollment ISO
dev/kanidm/key.pem
# OIDC client secrets (written by dev/kanidm/bootstrap.sh)
dev/synapse/oidc_client_secret
dev/stalwart/oidc_client_secret
# Attic cache signing keys (generated by `just setup`)
dev/attic/signing-key.sec
dev/attic/signing-key.pub
# Fleet VM SSH key (generated by `just setup`)
dev/ssh/

# Caddy dev reverse proxy: runtime data + auto-copied dev CA cert
dev/caddy/data/
dev/caddy/config/
dev/caddy/root.crt

# Helm subchart tarballs (fetched via `helm dep update`)
chart/hearth-home/charts/*.tgz

# OS
.DS_Store
Thumbs.db

# Fleet VM disk image (built by `just fleet-vm`)
hearth-fleet-vm.qcow2

# rust_uno crate (symlinked by nix develop shellHook). Match any
# location so an accidental `nix develop` inside a subdir (chart/, web/,
# etc.) that drops a stray symlink doesn't get committed.
rust_uno

# Extracted LO source (temp build artifact)
/libreoffice-*/

# (Note: dev/attic/cache-public-key is intentionally tracked — the key
# is public and committing it gets new clones to a buildable state
# without needing `just setup` first. `just setup` only re-creates it
# when the file is absent, so it won't trample a fresh clone's copy.)

# Stalwart webadmin bundle (fetched by `just setup`)
dev/stalwart/webadmin.zip

# Stale rust_uno crate copy in web/ (from earlier dev session)
web/rust_uno/
